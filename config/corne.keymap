#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <350>;
};

/ {
    combos {
        compatible = "zmk,combos";

        bluetooth {
            bindings = <&mo 3>;
            key-positions = <40 41>;
        };
    };

    behaviors {
        shift_lock: shift_lock {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_LOCK";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        layer_1: layer_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_1";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 1>, <&tog 1>;
        };

        layer_2: layer_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_2";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&mo 2>, <&tog 2>;
        };

        open_bracket: open_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "OPEN_BRACKET";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_PARENTHESIS>,
                <&kp LEFT_BRACKET>,
                <&kp LEFT_BRACE>;
        };

        close_bracket: close_bracket {
            compatible = "zmk,behavior-tap-dance";
            label = "CLOSE_BRACKET";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_PARENTHESIS>,
                <&kp RIGHT_BRACKET>,
                <&kp RIGHT_BRACE>;
        };
    };

    macros {
        accent_e: accent_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp E>;
            label = "ACCENT_E";
        };

        accent_a: accent_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp A>;
            label = "ACCENT_A";
        };

        accent_o: accent_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp O>;
            label = "ACCENT_O";
        };

        accent_u: accent_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE) &kp U>;
            label = "ACCENT_U";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&none  &kp Q        &kp W       &kp E            &kp R                &kp T                          &kp Y                &kp U        &kp I       &kp O       &kp P                &none
&none  &mt RCTRL A  &mt LALT S  &mt LGUI D       &mt LSHIFT F         &mt ESCAPE G                   &mt ESCAPE H         &mt RSHFT J  &mt RGUI K  &mt RALT L  &mt RCTRL SEMICOLON  &none
&none  &kp Z        &kp X       &kp C            &kp V                &kp B                          &kp N                &kp M        &kp COMMA   &kp PERIOD  &kp SLASH            &none
                                &mt LG(TAB) TAB  &mt LG(ENTER) ENTER  &mt LA(BACKSPACE) BACKSPACE    &mt LG(SPACE) SPACE  &layer_1     &layer_2
            >;
        };

        symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Symbols";
            bindings = <
&trans  &kp EXCL   &kp AT                &kp HASH        &kp DLLR   &kp PRCNT           &kp CARET          &kp AMPS       &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp GRAVE  &kp LS(LA(NUMBER_2))  &kp MINUS       &kp EQUAL  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp BACKSLASH  &kp SQT        &kp DOUBLE_QUOTES     &kp COLON              &trans
&trans  &kp TILDE  &kp LA(NUMBER_3)      &kp UNDERSCORE  &kp PLUS   &kp LEFT_BRACE      &kp RIGHT_BRACE    &kp PIPE       &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION           &trans
                                         &trans          &trans     &trans              &trans             &trans         &trans
            >;
        };

        numpad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Numpad";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4          &kp NUMBER_5            &kp NUMBER_6     &kp NUMBER_7          &kp NUMBER_8       &kp NUMBER_9          &kp NUMBER_0  &trans
&trans  &kp LCTRL     &kp LEFT_ALT  &kp LEFT_GUI  &kp LSHFT             &kp ESCAPE              &mt ESCAPE LEFT  &mt RIGHT_SHIFT DOWN  &mt RGUI UP_ARROW  &mt RALT RIGHT_ARROW  &kp RCTRL     &trans
&trans  &trans        &trans        &trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp C_VOLUME_UP  &kp C_VOLUME_DOWN     &trans             &trans                &trans        &trans
                                    &trans        &trans                &trans                  &trans           &trans                &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &none   &none   &none  &none  &trans
&trans  &none         &none         &none         &none         &none           &none       &none   &none   &none  &none  &trans
&trans  &none         &none         &none         &none         &none           &none       &none   &none   &none  &none  &trans
                                    &trans        &trans        &trans          &trans      &trans  &trans
            >;

            display-name = "Bluetooth";
        };
    };
};
